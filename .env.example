# TRUSTMESH Environment Configuration Template
# Copy this file to .env for local development:
#   copy .env.example .env (Windows cmd)
#   cp .env.example .env   (PowerShell / Linux)

# Flask Application Secret Key (Used to cryptographically sign session cookies & CSRF tokens)
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=trustmesh-local-development-secret-key-change-in-production-2026

# Flask Environment (Set to 'development' locally; never deploy 'development' in production)
FLASK_ENV=development

# ============================================================================
# Azure App Service & Production Hosting (Phase 4, Task 5)
# ============================================================================
# Listening port on Azure App Service (Azure sets this automatically to 8000)
PORT=5000

# Cookie Security (Set to 'true' for HTTPS production, 'false' for local HTTP)
COOKIE_SECURE=false

# Gunicorn Production Concurrency Settings (Configured via startup.sh)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ============================================================================
# Database Configuration (Phase 4: Dual-Mode Architecture)
# ============================================================================
# Database Mode: 'sqlite' (Default Local Mode) or 'azure_sql' (Cloud Mode)
DATABASE_MODE=sqlite

# Local SQLite Configuration (Used when DATABASE_MODE=sqlite)
DATABASE_PATH=instance/trustmesh.db

# Azure SQL Database Configuration (Used when DATABASE_MODE=azure_sql)
# Never commit real credentials to source control!
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=trustmesh-db
AZURE_SQL_USERNAME=your-admin-username
AZURE_SQL_PASSWORD=your-secure-password
AZURE_SQL_DRIVER={ODBC Driver 18 for SQL Server}

# Optional: Full Database Connection URL (Overrides individual parameters if provided)
# Example for Azure SQL: mssql+pyodbc://username:password@your-server.database.windows.net/trustmesh-db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
# DATABASE_URL=

# ============================================================================
# Azure Blob Storage Configuration (Phase 4: Optional Report Archiving)
# ============================================================================
# Storage is optional: if unconfigured, TRUSTMESH falls back to direct local downloads.
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccountname
AZURE_STORAGE_CONTAINER_NAME=trustmesh-reports
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccountname;AccountKey=your-storage-key;EndpointSuffix=core.windows.net
