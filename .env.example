# TRUSTMESH Environment Configuration Template
# Copy this file to .env for local development:
#   copy .env.example .env (Windows cmd)
#   cp .env.example .env   (PowerShell / Linux)

# Flask Application Secret Key (Used to cryptographically sign session cookies & CSRF tokens)
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=trustmesh-local-development-secret-key-change-in-production-2026

# Flask Environment (Set to 'development' locally; never deploy 'development' in production)
FLASK_ENV=development

# Optional: Custom database file location (defaults to instance/trustmesh.db)
# DATABASE_PATH=instance/trustmesh.db
